{
  "name": "@dolphin/studio",
  "version": "0.4.0",
  "description": "DOLPHin : moteur de contenu marketing IA intégrable à n'importe quel site web (génération, affiche, publication Meta).",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Yassine Chaabane",
  "homepage": "https://yassine1158.github.io/dolphin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yassine1158/dolphin.git"
  },
  "bugs": {
    "url": "https://github.com/yassine1158/dolphin/issues"
  },
  "engines": {
    "node": ">=22.9"
  },
  "main": "./dist/dolphin.esm.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dolphin.esm.js"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "import": "./dist/server.mjs"
    }
  },
  "bin": {
    "dolphin-server": "./dist/server-cli.mjs"
  },
  "files": [
    "COMMERCIAL-LICENSE.md",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "dist",
    "openapi.yaml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e",
    "demo": "npm run build && node --env-file-if-exists=.env scripts/demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
